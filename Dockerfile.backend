# ── Node.js backend + Python AI module ───────────────────────────────────────
#
# socket.js spawns the Python module using relative paths:
#   command : "../.venv/bin/python"
#   script  : "../../AsistenteWebTFGBackendAIModule/main.py"
# We reproduce the same directory structure inside /app/:
#
#   /app/
#     .venv/                          ← Python virtual environment
#     AsistenteWebTFGBackend/         ← Express server (process CWD)
#     AsistenteWebTFGBackendAIModule/ ← Python AI module
#
FROM node:18-slim

# ── System dependencies ───────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        python3-dev \
        build-essential \
        poppler-utils \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Python venv + AI dependencies ────────────────────────────────────────────
RUN python3 -m venv /app/.venv

# CPU-only PyTorch (smaller image; replace with +cuXXX index for NVIDIA GPU)
RUN /app/.venv/bin/pip install --no-cache-dir \
        torch==2.1.0 torchvision==0.16.0 --index-url https://download.pytorch.org/whl/cpu

RUN /app/.venv/bin/pip install --no-cache-dir \
        PyPDF2==3.0.1 \
        python-Levenshtein==0.27.3 \
        numpy==2.4.3 \
        opencv-python-headless \
        Pillow

# ── AI module source ──────────────────────────────────────────────────────────
COPY AsistenteWebTFGBackendAIModule/ /app/AsistenteWebTFGBackendAIModule/

# ── Node.js dependencies ──────────────────────────────────────────────────────
WORKDIR /app/AsistenteWebTFGBackend
COPY AsistenteWebTFGBackend/package*.json ./
RUN npm ci --omit=dev

# ── Backend source ────────────────────────────────────────────────────────────
COPY AsistenteWebTFGBackend/ ./

EXPOSE 3000

CMD ["node", "./bin/www"]
